  program: string;
}

// Opt-in structured permission details from the same retained occurrence as
// question. Permission is present only for a runtime first-use record;
// canonical legacy records are read through the explicit legacy reader. Other
// outcomes carry no permission. Existing operator responses retain their closed
// shapes. All exact target strings remain complete regardless of presentation
// limits.
export interface QuestionDetails {
  question: AttributedQuestion;
  permission: PermissionRequest | null;
}

// Answer is present exactly for pending/answered. Pending has no
// option/yes/kept decision. Unknown is an unobserved key in this caller's
// scope. Gone retains a forgotten admission's key and never admits it again.
// Conflict means the key was previously used with different content.
// Unavailable includes storage/capacity refusal and establishes no human
// decision. Answered reports the recorded human choice; it grants no resource
// authority by itself.
export interface QuestionObservation {
  outcome: ObservationOutcome;
  answer: Answer | null;
}

