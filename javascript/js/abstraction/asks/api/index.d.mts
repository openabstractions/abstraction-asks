// Answered means the question choice is recorded, including an idempotent
// same-option replay. Effect reports the separate exact resource-rule write:
// none for a refusal, applied for a successful bounded rule, conflict for a
// policy revision change or an already-answered replay, forbidden for expired
// or revoked delegation, unavailable for an unconfirmed policy write. A
// recorded answer may have an unapplied effect. An answered replay never writes
// target policy: inspect target outcome and reconcile through an explicit
// operator edit. Target outcome is the current rights decision word when a
// fresh read succeeds. No caller-supplied target or rule is accepted.
export interface ResponderDecision {
  outcome: OperatorDecisionOutcome;
  record: RecordMetadata | null;
  effect: ResponderEffectOutcome;
  targetOutcome: string;
}

