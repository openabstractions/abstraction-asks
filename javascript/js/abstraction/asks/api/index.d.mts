// Trusted permission details and asker attribution from one retained
// occurrence. program is the bound program the application service derived the
// question's subject from: the clean absolute executable path the platform
// proved at admission, up to 4096 bytes. The record's asker is its display
// name, derived from it. Program is absent for every refusal, for the runtime's
// own questions and for a question admitted before the service kept it. The
// service supplies it; request text never does. An unrecoverable legacy
// permission target returns unavailable without details or program.
export interface QuestionAsker {
